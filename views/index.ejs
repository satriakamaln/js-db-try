<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        DEACODE - JS DB Try
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>

<body>
    <h3>
        <%= title %>
    </h3>
    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">id</th>
                    <th scope="col">Nama</th>
                    <th scope="col">Kelas</th>
                    <th scope="col">Option</th>
                </tr>
            </thead>
            <tbody>
                <% for (let user of users) { %>
                    <tr>
                        <th scope="row">
                            <%= user.id %>
                        </th>
                        <td>
                            <%= user.nama %>
                        </td>
                        <td>
                            <%= user.kelas %>
                        </td>
                        <td>
                            <a href="/hapus/<%= user.id %>" class="btn btn-danger" id="hapus-btn">Hapus</a>
                            <a href="/edit/<%= user.id %>" class="btn btn-warning">Edit</a>
                        </td>
                    </tr>
                    <% } %>
            </tbody>
        </table>

        <form action="/tambah" method="POST">
            <h3>TAMBAH MURID</h3>
            <div class="row mb-3">
                <label for="inputEmail3" class="col-sm-2 col-form-label">Nama</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" name="nama">
                </div>
            </div>
            <div class="row mb-3">
                <label for="inputPassword3" class="col-sm-2 col-form-label">Kelas</label>
                <div class="col-sm-10">
                    <input type="text" class="form-control" name="kelas">
                </div>
            </div>

            <button type="submit" class="btn btn-success">TAMBAH</button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>

    <script>
        const hapusBtn = document.getElementById('hapus-btn');
        hapusBtn.addEventListener('click', function (event) {
            event.preventDefault(); // Mencegah aksi default (navigasi)
            const confirmDelete = confirm('Apakah Anda yakin ingin menghapus data ini?');
            if (confirmDelete) {
                window.location.href = this.href; // Lanjutkan ke URL jika pengguna mengkonfirmasi
            }
        });
    </script>
</body>

</html>